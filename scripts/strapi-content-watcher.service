[Unit]
Description=Xlam published Strapi content watcher
After=network-online.target xlam-cms.service
Wants=network-online.target

[Service]
Type=simple
User=xlam-deploy
Group=xlam-deploy
WorkingDirectory=/srv/xlam-deploy/source
EnvironmentFile=/srv/xlam-deploy/build.env
ExecStart=/usr/local/bin/node /srv/xlam-deploy/source/scripts/watch-strapi-content.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/xlam-deploy /srv/xlam-production
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
